{
  "name": "maer-chat-windows",
  "version": "1.1.0",
  "description": "Client XMPP sécurisé MAER Chat pour Windows",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": {
    "name": "MAER Engineering"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "test:visual": "node tests/visual/run.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "converse.js": "14.0.0",
    "hash-wasm": "4.12.0",
    "kdbxweb": "2.1.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "playwright": "^1.58.2",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "fr.maer.chat.windows",
    "productName": "MAER Chat",
    "artifactName": "MAER-Chat-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@napi-rs/keyring/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAER Chat",
      "deleteAppDataOnUninstall": false
    }
  },
  "overrides": {
    "kdbxweb": {
      "@xmldom/xmldom": "0.8.15"
    }
  }
}
