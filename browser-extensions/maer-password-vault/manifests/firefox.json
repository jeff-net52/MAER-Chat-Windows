{
  "manifest_version": 3,
  "name": "MAER Chat - Coffre de mots de passe",
  "short_name": "Coffre MAER",
  "version": "0.1.0",
  "description": "Remplissage explicite et securise depuis le coffre local MAER Chat.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "common/constants.js",
      "common/protocol.js",
      "background/native-client.js",
      "background/service-worker.js"
    ]
  },
  "action": {
    "default_title": "Coffre MAER",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "ui/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "password-vault@maer.fr",
      "strict_min_version": "128.0"
    }
  }
}
